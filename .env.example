# Database connection (required for Companion System V2)
# For local development with Docker Compose:
DATABASE_URL=postgresql://utsuwa:utsuwa@localhost:5432/utsuwa

# Alternative: Use your own PostgreSQL instance
# DATABASE_URL=postgresql://user:password@localhost:5432/utsuwa

# Server-side profile sync (cross-device save/load via PIN)
# Copy to .env.local and set to "true" to enable in development
# UTSUWA_PROFILE_SYNC_ENABLED=true
# UTSUWA_DATA_DIR=/tmp/utsuwa-data

# MCP tool endpoints (executed server-side)
# Copy to .env.local and set to "true" to enable MCP tool use
# UTSUWA_MCP_ENABLED=true

# Allow browsers to reach providers running on localhost or private IPs
# (e.g. Ollama, LM Studio, local TTS/STT bridges)
# ALLOW_LOCAL_PROVIDER_HOSTS=true
