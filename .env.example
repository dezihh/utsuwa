# Database connection (required for Companion System V2)
# For local development with Docker Compose:
DATABASE_URL=postgresql://utsuwa:utsuwa@localhost:5432/utsuwa

# Alternative: Use your own PostgreSQL instance
# DATABASE_URL=postgresql://user:password@localhost:5432/utsuwa

# MCP tool endpoints (web/server builds). Off by default — only enable on
# deployments you control, since stdio servers run local commands.
# Values: unset/off (disabled), server (active), client/both (reserved)
# MCP_ENABLED=server
# Optional MCP hardening (default off, web runtime / build-time on desktop):
# PUBLIC_MCP_PROMPT_HARDENING=true
# PUBLIC_MCP_CONFIRM_TOOLS=unlock_door,set_alarm
# Restrict stdio commands on the server (unset = any command allowed):
# MCP_STDIO_ALLOWED_COMMANDS=npx,node,uvx
